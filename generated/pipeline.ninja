# Generated by `lake exe gen` from spec/BioMech/Pipeline.lean. Edit the Lean source, then regenerate: cd spec && lake exe gen
# Pipeline build file: one rule and one build statement per stage, in topological order.
# Run from the repository root: ninja -f generated/pipeline.ninja

ninja_required_version = 1.3

# The pipeline interpreter: the default prefix of pipeline/env/setup.sh.
python = $$HOME/.local/share/bm-opensim/bin/python

# Merge the trunk, arm, and neck muscles of the upper-body models onto the
# scaled Rajagopal model, give the head its own body behind a neck joint, and
# add the neck angles that hold the head level in space to the joint angles
# (D-008, D-009, D-010).
rule buildModel
  command = $python -m pipeline.build_model
  description = buildModel: Merge the trunk, arm, and neck muscles of the upper-body models onto the scaled Rajagopal model, give the head its own body behind a neck joint, and add the neck angles that hold the head level in space to the joint angles (D-008, D-009, D-010).
build data/work/model.osim data/work/ik_full.mot: buildModel data/raw/rajagopal/walk_pipeline/Scale/subject_scaled_walk.osim data/raw/rajagopal/walk_pipeline/IK/results_walk/ik_output_walk.mot pipeline/config/model.yaml data/raw/rajagopal/walk_pipeline/Scale/scaleSet_applied_walk.xml data/raw/rajagopal/walk_pipeline/Scale/scale_output_walk.mot data/raw/fbls/FBLSmodel.osim data/raw/holzbaur/Stanford_VA_Upper_Limb_original.osim data/raw/mortensen/HYOID_1.2_ScaledStrenght_UpdatedInertia.osim data/raw/mortensen/Geometry/skull.vtp data/raw/rajagopal/Geometry | pipeline/build_model.py
build buildModel: phony data/work/model.osim data/work/ik_full.mot

# Load the merged model and the walking trial with the OpenSim API.
rule loadModel
  command = $python -m pipeline.load_model
  description = loadModel: Load the merged model and the walking trial with the OpenSim API.
build data/work/model.json data/work/kinematics.csv data/work/grf.csv: loadModel data/work/model.osim data/work/ik_full.mot data/raw/rajagopal/walk_pipeline/ExpData/grf_walk.mot | pipeline/load_model.py
build loadModel: phony data/work/model.json data/work/kinematics.csv data/work/grf.csv

# Static optimisation: muscle activations per frame.
rule runStaticOpt
  command = $python -m pipeline.static_opt
  description = runStaticOpt: Static optimisation: muscle activations per frame.
build data/work/activations.csv: runStaticOpt data/work/model.osim data/raw/rajagopal/walk_pipeline/ID/grf_walk.xml data/raw/rajagopal/walk_pipeline/ExpData/grf_walk.mot data/work/kinematics.csv | pipeline/static_opt.py
build runStaticOpt: phony data/work/activations.csv

# Moment arm and muscle-tendon length per muscle, coordinate, and frame;
# length velocity gives concentric or eccentric work.
rule computeMomentArms
  command = $python -m pipeline.moment_arms
  description = computeMomentArms: Moment arm and muscle-tendon length per muscle, coordinate, and frame; length velocity gives concentric or eccentric work.
build data/work/moment_arms.csv data/work/mt_lengths.csv: computeMomentArms data/work/model.osim data/work/kinematics.csv | pipeline/moment_arms.py
build computeMomentArms: phony data/work/moment_arms.csv data/work/mt_lengths.csv

# Detect gait events and drive the generated gait FSM to label each frame
# with its phase.
rule segmentPhases
  command = $python -m pipeline.segment_phases
  description = segmentPhases: Detect gait events and drive the generated gait FSM to label each frame with its phase.
build data/work/phases.csv: segmentPhases data/work/model.osim data/work/kinematics.csv data/work/grf.csv | pipeline/segment_phases.py
build segmentPhases: phony data/work/phases.csv

# Classify each muscle per phase and joint action as main mover, helper,
# stabiliser, or antagonist.
rule labelRoles
  command = $python -m pipeline.label_roles
  description = labelRoles: Classify each muscle per phase and joint action as main mover, helper, stabiliser, or antagonist.
build data/work/roles.json: labelRoles data/work/model.json data/work/activations.csv data/work/moment_arms.csv data/work/mt_lengths.csv data/work/phases.csv data/work/kinematics.csv pipeline/config/roles.yaml | pipeline/label_roles.py
build labelRoles: phony data/work/roles.json

# Add common names, ontology identifiers, attachments, and innervation.
rule enrichAnatomy
  command = $python -m pipeline.enrich_anatomy
  description = enrichAnatomy: Add common names, ontology identifiers, attachments, and innervation.
build data/work/enriched.json: enrichAnatomy data/work/roles.json data/work/model.json data/raw/ontology/uberon.obo data/raw/ontology/fma.owl data/curated/anatomy.yaml | pipeline/enrich_anatomy.py
build enrichAnatomy: phony data/work/enriched.json

# Write the knowledge graph `data/out/graph.json` (contract C3).
rule exportGraph
  command = $python -m pipeline.export_graph
  description = exportGraph: Write the knowledge graph `data/out/graph.json` (contract C3).
build data/out/graph.json: exportGraph data/work/enriched.json | pipeline/export_graph.py
build exportGraph: phony data/out/graph.json

# Convert the model's bone geometry to glTF, each mesh multiplied by its
# scale factors from the merged model.
rule exportMeshes
  command = $python -m pipeline.export_meshes
  description = exportMeshes: Convert the model's bone geometry to glTF, each mesh multiplied by its scale factors from the merged model.
build data/out/meshes/index.json: exportMeshes data/work/model.osim data/work/model.json data/raw/rajagopal/Geometry | pipeline/export_meshes.py
build exportMeshes: phony data/out/meshes/index.json

# Write muscle path points per frame for the tube renderer, with the
# bounds of the stride the knowledge graph describes.
rule exportMusclePaths
  command = $python -m pipeline.export_muscle_paths
  description = exportMusclePaths: Write muscle path points per frame for the tube renderer, with the bounds of the stride the knowledge graph describes.
build data/out/muscle_paths.json: exportMusclePaths data/work/model.osim data/work/kinematics.csv data/work/activations.csv data/work/mt_lengths.csv data/work/phases.csv | pipeline/export_muscle_paths.py
build exportMusclePaths: phony data/out/muscle_paths.json

# Write each muscle's moment about each joint coordinate, and the
# coordinate's angle, per frame, for the dynamics panel.
rule exportDynamics
  command = $python -m pipeline.export_dynamics
  description = exportDynamics: Write each muscle's moment about each joint coordinate, and the coordinate's angle, per frame, for the dynamics panel.
build data/out/dynamics.json: exportDynamics data/work/model.json data/work/kinematics.csv data/work/activations.csv data/work/moment_arms.csv data/work/mt_lengths.csv data/work/phases.csv pipeline/config/roles.yaml data/curated/anatomy.yaml | pipeline/export_dynamics.py
build exportDynamics: phony data/out/dynamics.json
