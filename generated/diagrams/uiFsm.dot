digraph uiFsm {
  rankdir=LR;
  node [shape=ellipse, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  label="Every (state, event) pair absent from TRANSITIONS leaves the state as it is.";
  labelloc=b;
  __start [shape=point, label=""];
  "idle" [shape=doublecircle];
  "playing" [shape=doublecircle];
  "paused" [shape=doublecircle];
  "scrubbing" [shape=doublecircle];
  "inspectingNode" [shape=doublecircle];
  __start -> "idle";
  "idle" -> "playing" [label="play"];
  "idle" -> "scrubbing" [label="scrubStart"];
  "idle" -> "inspectingNode" [label="selectNode"];
  "playing" -> "paused" [label="pause"];
  "playing" -> "idle" [label="stop"];
  "playing" -> "paused" [label="reachEnd"];
  "playing" -> "scrubbing" [label="scrubStart"];
  "playing" -> "inspectingNode" [label="selectNode"];
  "paused" -> "playing" [label="play"];
  "paused" -> "idle" [label="stop"];
  "paused" -> "scrubbing" [label="scrubStart"];
  "paused" -> "inspectingNode" [label="selectNode"];
  "scrubbing" -> "paused" [label="scrubEnd"];
  "inspectingNode" -> "playing" [label="play"];
  "inspectingNode" -> "idle" [label="stop"];
  "inspectingNode" -> "scrubbing" [label="scrubStart"];
  "inspectingNode" -> "inspectingNode" [label="selectNode"];
  "inspectingNode" -> "paused" [label="closeInspector"];
}
