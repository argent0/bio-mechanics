// Generated by `lake exe gen` from spec/BioMech/GaitFsm.lean. Edit the Lean source, then regenerate: cd spec && lake exe gen
digraph gaitFsm {
  rankdir=LR;
  node [shape=ellipse, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  label="Every (state, event) pair absent from TRANSITIONS goes to invalid.";
  labelloc=b;
  __start [shape=point, label=""];
  "loadingResponse" [shape=doublecircle];
  "midStance";
  "terminalStance";
  "preSwing";
  "initialSwing";
  "midSwing";
  "terminalSwing";
  "invalid";
  __start -> "loadingResponse";
  "loadingResponse" -> "midStance" [label="oppositeToeOff"];
  "midStance" -> "terminalStance" [label="heelOff"];
  "terminalStance" -> "preSwing" [label="oppositeInitialContact"];
  "preSwing" -> "initialSwing" [label="toeOff"];
  "initialSwing" -> "midSwing" [label="feetAdjacent"];
  "midSwing" -> "terminalSwing" [label="tibiaVertical"];
  "terminalSwing" -> "loadingResponse" [label="initialContact"];
}
