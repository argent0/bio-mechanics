# Lean
spec/.lake/
# Python
__pycache__/
*.pyc
.mypy_cache/
.venv/
# Node
node_modules
web/dist/
# Data: large raw downloads stay local
data/raw/**/*.mot
data/raw/**/*.trc
data/raw/**/*.vtp
data/raw/**/*.sto
data/work/
# FBLS trunk model: its licence forbids redistribution (D-011); fetched by pipeline/env/fetch_data.sh
data/raw/fbls/
# Ontology downloads: re-fetched by data/raw/ontology/ scripts
data/raw/ontology/*.obo
data/raw/ontology/*.owl
data/raw/ontology/*.json.gz
!data/raw/ontology/uberon.obo
# Ninja build state
.ninja_log
.ninja_deps
