import Lean
import BioMech.Schema

/-!
# Schema reflection

Loads the compiled `BioMech.Schema` environment and reads the schema from its
declarations: the constructors of `Kind` and `SchemaArrow`, the arrows' source
and target kinds, the fields of every attribute structure, and their docstrings.
The emitters work from the resulting `SchemaSpec`, so the Lean declarations stay
the single source of the generated types.
-/

namespace BioMech.Gen
open Lean

/-- Field types the emitters translate. -/
inductive FieldTy
  | string | float | nat | int | bool
  | option (t : FieldTy)
  | array (t : FieldTy)
  /-- An enumeration declared in `BioMech.Schema`, by short name. -/
  | enum (name : String)
  deriving Inhabited, Repr

structure FieldSpec where
  name : String
  ty : FieldTy
  doc : Option String

structure StructSpec where
  name : String
  doc : Option String
  fields : List FieldSpec

structure EnumSpec where
  name : String
  doc : Option String
  ctors : List String

structure ArrowSpec where
  name : String
  source : String
  target : String
  /-- Short name of the attribute structure, when the arrow carries one. -/
  attrs : Option String

structure SchemaSpec where
  version : Nat
  enums : List EnumSpec
  structs : List StructSpec
  arrows : List ArrowSpec
  deriving Inhabited

def short (n : Name) : String := n.lastComponentAsString

def doc? (env : Environment) (n : Name) : IO (Option String) :=
  return (← findDocString? env n).map (·.trimAscii.toString)

def ctorsOf (env : Environment) (n : Name) : Except String (List Name) :=
  match env.find? n with
  | some (.inductInfo v) => .ok v.ctors
  | _ => .error s!"{n} is missing or is no inductive type"

/-- Enumerations: inductives in `BioMech` whose constructors take no arguments. -/
def isEnum (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | some (.inductInfo v) => v.numParams == 0 && v.numIndices == 0 &&
      v.ctors.all fun c => match env.find? c with
        | some (.ctorInfo cv) => cv.numFields == 0
        | _ => false
  | _ => false

partial def fieldTy (env : Environment) (e : Expr) : Except String FieldTy :=
  match e.getAppFn, e.getAppArgs with
  | .const ``String _, #[] => .ok .string
  | .const ``Float _, #[] => .ok .float
  | .const ``Nat _, #[] => .ok .nat
  | .const ``Int _, #[] => .ok .int
  | .const ``Bool _, #[] => .ok .bool
  | .const ``Option _, #[t] => return .option (← fieldTy env t)
  | .const ``Array _, #[t] => return .array (← fieldTy env t)
  | .const n _, #[] => if isEnum env n then .ok (.enum (short n)) else .error s!"unsupported field type {n}"
  | _, _ => .error s!"unsupported field type {e}"

/-- Enumerations a field type refers to. -/
def enumsIn : FieldTy → List String
  | .option t | .array t => enumsIn t
  | .enum n => [n]
  | _ => []

def structSpec (env : Environment) (n : Name) : IO StructSpec := do
  let fields ← (getStructureFields env n).toList.mapM fun f => do
    let proj := n ++ f
    let some info := env.find? proj | throw <| IO.userError s!"missing projection {proj}"
    let ty ← IO.ofExcept (fieldTy env info.type.bindingBody!)
    return { name := f.toString, ty, doc := ← doc? env proj : FieldSpec }
  return { name := short n, doc := ← doc? env n, fields }

def enumSpec (env : Environment) (n : Name) : IO EnumSpec := do
  let cs ← IO.ofExcept (ctorsOf env n)
  return { name := short n, doc := ← doc? env n, ctors := cs.map short }

/-- Source and target kinds of a `SchemaArrow` constructor, read from its type. -/
def arrowSpec (env : Environment) (c : Name) : IO ArrowSpec := do
  let some info := env.find? c | throw <| IO.userError s!"missing constructor {c}"
  match info.type.getAppArgs with
  | #[.const s _, .const t _] =>
    let attrs := (edgeAttrs.find? (·.1 == c)).map (short ·.2)
    return { name := short c, source := short s, target := short t, attrs }
  | _ => throw <| IO.userError s!"unexpected type of {c}: {info.type}"

/-- Reads the whole schema from the compiled `BioMech.Schema` module. -/
def loadSchema : IO SchemaSpec := do
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `BioMech.Schema }] {}
  let structs ← ([``NodeAttrs] ++ edgeAttrs.map (·.2)).mapM (structSpec env)
  let used := structs.flatMap fun s => s.fields.flatMap (enumsIn ·.ty)
  let enumNames := used.foldl (fun acc n => if acc.contains n then acc else acc ++ [n]) ["Kind"]
  let enums ← enumNames.mapM fun n => enumSpec env (`BioMech ++ n.toName)
  let arrows ← (← IO.ofExcept (ctorsOf env ``SchemaArrow)).mapM (arrowSpec env)
  return { version := schemaVersion, enums, structs, arrows }

/-- First line of every generated file (inside the target language's comment syntax). -/
def headerText (source : String) : String :=
  s!"Generated by `lake exe gen` from {source}. Edit the Lean source, then regenerate: cd spec && lake exe gen"

end BioMech.Gen
