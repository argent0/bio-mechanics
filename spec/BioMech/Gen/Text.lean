import Lean

/-!
# Text helpers for the emitters

Docstring layout, identifier spelling, string quoting, and a small JSON value
type whose objects keep their keys in the order the emitter writes them.

## Terms

* *Dedent*: remove the indentation that Lean docstrings carry on their
  continuation lines, so each line starts at the docstring's left margin.
* *Upper snake case*: `strideWord` spelled `STRIDE_WORD`, the spelling of
  generated constants.
-/

namespace BioMech.Gen

/-- `s` with leading and trailing whitespace removed. -/
def trim (s : String) : String :=
  let drop (cs : List Char) := cs.dropWhile Char.isWhitespace
  String.ofList (drop (drop s.toList).reverse).reverse

/-- Count of leading spaces of `s`. -/
def indentOf (s : String) : Nat := (s.toList.takeWhile (· == ' ')).length

/-- The lines of a docstring, trimmed at both ends and dedented: continuation
lines lose their common indentation, so nested bullets keep their relative
indentation. -/
def docLines (d : String) : List String :=
  match (trim d).splitOn "\n" with
  | [] => []
  | first :: rest =>
    let ind := (rest.filter (trim · != "")).map indentOf |>.min? |>.getD 0
    let trimR (s : String) := String.ofList (s.toList.reverse.dropWhile Char.isWhitespace).reverse
    trim first :: rest.map fun l => trimR (String.ofList (l.toList.drop ind))

/-- A docstring as one line: its lines joined by spaces. -/
def docOneLine (d : String) : String := " ".intercalate ((docLines d).map trim |>.filter (· != ""))

/-- The first sentence of a docstring, on one line. -/
def docSummary (d : String) : String :=
  let s := docOneLine d
  match s.splitOn ". " with
  | first :: _ :: _ => first ++ "."
  | _ => s

/-- `strideWord` → `STRIDE_WORD`, `GaitPhase.phases` → `PHASES` (last component). -/
def upperSnake (s : String) : String :=
  let last := (s.splitOn ".").getLast?.getD s
  String.ofList <| last.toList.foldl (init := []) fun acc c =>
    if c.isUpper && !acc.isEmpty then acc ++ ['_', c] else acc ++ [c.toUpper]

/-- `pipeline/load_model.py` → `pipeline.load_model`: the module `python -m` runs. -/
def pyModuleOf (script : String) : String :=
  let noExt := if script.endsWith ".py" then String.ofList (script.toList.take (script.length - 3)) else script
  noExt.replace "/" "."

/-- Double-quoted string literal, valid in JSON, TypeScript, Python, and DOT. -/
def jsonQuote (s : String) : String :=
  let esc (c : Char) : String :=
    match c with
    | '"' => "\\\"" | '\\' => "\\\\" | '\n' => "\\n" | '\r' => "\\r" | '\t' => "\\t"
    | c => if c.toNat < 0x20 then
        let h := Nat.toDigits 16 c.toNat
        "\\u" ++ String.ofList (List.replicate (4 - h.length) '0' ++ h)
      else c.toString
  "\"" ++ String.join (s.toList.map esc) ++ "\""

/-- The path of a Lean module's source file relative to the repository root,
e.g. `spec/BioMech/GaitFsm.lean`. -/
def moduleFile (m : Lean.Name) : String :=
  "spec/" ++ "/".intercalate (m.components.map (·.toString)) ++ ".lean"

/-- First line of every generated file (inside the target language's comment syntax). -/
def headerText (source : String) : String :=
  s!"Generated by `lake exe gen` from {source}. Edit the Lean source, then regenerate: cd spec && lake exe gen"

/-- A TypeScript doc comment, one line or a block. -/
def tsComment (indent : String) : Option String → List String
  | none => []
  | some d =>
    match (docLines d).map (·.replace "*/" "*\\/") with
    | [l] => [s!"{indent}/** {l} */"]
    | ls => [s!"{indent}/**"] ++ ls.map (fun l => if l == "" then s!"{indent} *" else s!"{indent} * {l}") ++
        [s!"{indent} */"]

/-- `#` comment lines (Python, ninja). -/
def hashComment (indent : String) : Option String → List String
  | none => []
  | some d => (docLines d).map fun l => if l == "" then s!"{indent}#" else s!"{indent}# {l}"

/-- A Python docstring, one line or a block. -/
def pyDocstring (indent : String) : Option String → List String
  | none => []
  | some d =>
    match (docLines d).map (fun l => (l.replace "\\" "\\\\").replace "\"\"\"" "\\\"\"\"") with
    | [l] => [s!"{indent}\"\"\"{l}\"\"\""]
    | l :: ls => [s!"{indent}\"\"\"{l}"] ++ ls.map (fun x => if x == "" then "" else indent ++ x) ++
        [s!"{indent}\"\"\""]
    | [] => []

/-- `lines` without its trailing empty lines. -/
def dropTrailingBlank (lines : List String) : List String :=
  (lines.reverse.dropWhile (· == "")).reverse

/-! ## JSON with ordered keys -/

/-- A JSON value. Objects keep their keys in the order given. -/
inductive J
  | null
  | bool (b : Bool)
  | num (n : Nat)
  | str (s : String)
  | arr (xs : List J)
  | obj (kvs : List (String × J))
  deriving Inhabited

def J.ofOpt : Option String → J
  | some s => .str s
  | none => .null

def J.strs (xs : List String) : J := .arr (xs.map .str)

def J.isScalar : J → Bool
  | .arr _ | .obj _ => false
  | _ => true

/-- Widest line, indentation included, of an object kept on one line. -/
def inlineWidth : Nat := 120

/-- Renders `j` with two-space indentation. Arrays of scalars stay on one line,
and so do objects of scalars that fit in `inlineWidth`. -/
partial def J.render (j : J) (ind : String := "") : String :=
  let inner := ind ++ "  "
  match j with
  | .null => "null"
  | .bool b => toString b
  | .num n => toString n
  | .str s => jsonQuote s
  | .arr [] => "[]"
  | .arr xs =>
    if xs.all J.isScalar then "[" ++ ", ".intercalate (xs.map (·.render)) ++ "]"
    else "[\n" ++ ",\n".intercalate (xs.map fun x => inner ++ x.render inner) ++ "\n" ++ ind ++ "]"
  | .obj [] => "{}"
  | .obj kvs =>
    let flat := "{ " ++ ", ".intercalate (kvs.map fun (k, v) => jsonQuote k ++ ": " ++ v.render) ++ " }"
    if kvs.all (·.2.isScalar) && ind.length + flat.length ≤ inlineWidth then flat else
    "{\n" ++ ",\n".intercalate (kvs.map fun (k, v) => inner ++ jsonQuote k ++ ": " ++ v.render inner) ++
      "\n" ++ ind ++ "}"

end BioMech.Gen
