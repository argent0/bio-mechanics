import Lean.Data.Json
import BioMech.Architecture

/-!
# `generated/modules.json`

The module map as JSON, read by the arch viewer (`tools/arch/`). Shape:
`{"$generated": header, "modules": [Module], "apis": [Api]}`, where each module
also carries its `layer` (0 = top) and the ids of the APIs it produces and consumes.
-/

namespace BioMech.Arch
open Lean

def ModuleId.name (m : ModuleId) : String :=
  (toString (repr m)).replace "BioMech.Arch.ModuleId." ""

def ApiId.name (a : ApiId) : String :=
  (toString (repr a)).replace "BioMech.Arch.ApiId." ""

def ModState.name : ModState → String
  | .planned => "planned" | .running => "running" | .review => "review" | .merged => "merged"

def produces (m : ModuleId) : List Api := apis.filter (·.producer == m)
def consumes (m : ModuleId) : List Api := apis.filter (·.consumers.contains m)

def header : String :=
  "Generated by `lake exe arch export` from spec/BioMech/Architecture.lean. Regenerate: cd spec && lake exe arch export"

def moduleJson (m : Module) : Json :=
  Json.mkObj [
    ("id", m.id.name), ("name", m.name), ("lang", m.lang), ("model", m.model),
    ("state", m.state.name), ("layer", layer m.id),
    ("paths", toJson m.paths), ("acceptance", toJson m.acceptance),
    ("produces", toJson ((produces m.id).map (·.id.name))),
    ("consumes", toJson ((consumes m.id).map (·.id.name)))]

def apiJson (a : Api) : Json :=
  Json.mkObj [
    ("id", a.id.name), ("name", a.name), ("files", toJson a.files),
    ("producer", a.producer.name), ("consumers", toJson (a.consumers.map (·.name)))]

def modulesJson : Json :=
  Json.mkObj [("$generated", header),
    ("modules", toJson (modules.map moduleJson)), ("apis", toJson (apis.map apiJson))]

end BioMech.Arch
